              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bomGroups\": [\n    { \"name\": \"Glass System\",        \"items\": [] },\n    { \"name\": \"Framing System\",      \"items\": [] },\n    { \"name\": \"Hardware\",            \"items\": [] },\n    { \"name\": \"Fabrication & Labor\", \"items\": [] }\n  ],\n  \"bomTotals\": {\n    \"subtotal\": 0,\n    \"shipping\": 0,\n    \"overhead\": 0,\n    \"profit\":   0,\n    \"total\":    0\n  },\n  \"revisionNumber\": {{revisionNumber}}\n}"
            },
            "description": "All item arrays are empty — tests the edge case where a user clears all BOM lines.\nThe mapper handles this safely without crashing.\nExpected: 200"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200 — empty items arrays are valid', () => pm.response.to.have.status(200));",
              "const newRev = pm.response.json().revisionNumber;",
              "if (newRev) pm.collectionVariables.set('revisionNumber', String(newRev));"
            ]}
          }]
        },
        {
          "name": "POST BOM — Stale Revision (409 Conflict)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/{{projectId}}/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","{{projectId}}","bom"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bomGroups\": [\n    {\n      \"name\": \"Glass System\",\n      \"items\": [\n        { \"id\": \"gs-panel-1\", \"name\": \"Glass Panels\", \"costPerUnit\": 25.00, \"qty\": 30, \"price\": 750.00 }\n      ]\n    },\n    { \"name\": \"Framing System\",      \"items\": [] },\n    { \"name\": \"Hardware\",            \"items\": [] },\n    { \"name\": \"Fabrication & Labor\", \"items\": [] }\n  ],\n  \"bomTotals\": {\n    \"subtotal\": 750.00,\n    \"shipping\":  10.00,\n    \"overhead\":  75.00,\n    \"profit\":   150.00,\n    \"total\":    985.00\n  },\n  \"revisionNumber\": 0\n}"
            },
            "description": "Uses hardcoded revisionNumber: 0 — which is stale if any previous POST BOM\nhas already run. The backend must reject this with 409 STALE_REVISION.\n\nThis simulates Estimator B trying to save with outdated data."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 409 Conflict', () => pm.response.to.have.status(409));",
              "pm.test('Error code STALE_REVISION', () => pm.expect(pm.response.json().error.code).to.equal('STALE_REVISION'));",
              "pm.test('Message mentions concurrent modification', () => {",
              "  pm.expect(pm.response.json().error.message).to.include('modified by another user');",
              "});"
            ]}
          }]
        },
