    {
      "name": "4 — Concurrent Edit Simulation",
      "description": "Simulates two estimators editing the same BOM.\nRun [Estimator A] first to advance the revision, then run [Estimator B].\nEstimator B will be rejected with 409 STALE_REVISION.",
      "item": [
        {
          "name": "[Estimator A] Save — Advances Revision",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/{{projectId}}/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","{{projectId}}","bom"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bomGroups\": [\n    {\n      \"name\": \"Glass System\",\n      \"items\": [\n        { \"id\": \"gs-panel-1\", \"name\": \"Glass Panels — Estimator A Edit\", \"costPerUnit\": 21.00, \"qty\": 30, \"price\": 630.00 }\n      ]\n    },\n    { \"name\": \"Framing System\",      \"items\": [] },\n    { \"name\": \"Hardware\",            \"items\": [] },\n    { \"name\": \"Fabrication & Labor\", \"items\": [] }\n  ],\n  \"bomTotals\": { \"subtotal\": 630.00, \"shipping\": 0, \"overhead\": 0, \"profit\": 0, \"total\": 630.00 },\n  \"revisionNumber\": {{revisionNumber}}\n}"
            },
            "description": "Estimator A saves using the current revisionNumber.\nStores the new (advanced) revisionNumber in the collection variable.\nEstimator B's request below uses the old stale revision (hardcoded 0)."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Estimator A save succeeded (200)', () => pm.response.to.have.status(200));",
              "const newRev = pm.response.json().revisionNumber;",
              "pm.collectionVariables.set('revisionNumber', String(newRev));",
              "pm.collectionVariables.set('revisionNumberAfterA', String(newRev));",
              "console.log('Estimator A saved. New revision:', newRev, '— Estimator B will use stale revision 0.');"
            ]}
          }]
        },
        {
          "name": "[Estimator B] Stale Save — Must 409",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/{{projectId}}/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","{{projectId}}","bom"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bomGroups\": [\n    {\n      \"name\": \"Glass System\",\n      \"items\": [\n        { \"id\": \"gs-panel-1\", \"name\": \"Glass Panels — Estimator B Edit (WILL BE REJECTED)\", \"costPerUnit\": 19.00, \"qty\": 30, \"price\": 570.00 }\n      ]\n    },\n    { \"name\": \"Framing System\",      \"items\": [] },\n    { \"name\": \"Hardware\",            \"items\": [] },\n    { \"name\": \"Fabrication & Labor\", \"items\": [] }\n  ],\n  \"bomTotals\": { \"subtotal\": 570.00, \"shipping\": 0, \"overhead\": 0, \"profit\": 0, \"total\": 570.00 },\n  \"revisionNumber\": 0\n}"
            },
            "description": "Estimator B sends revisionNumber: 0 — which is stale because Estimator A already\nadvanced it. The backend's dual-layer optimistic lock must reject this.\n\nExpected: 409 STALE_REVISION"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Estimator B rejected 409', () => pm.response.to.have.status(409));",
              "pm.test('Error code STALE_REVISION', () => pm.expect(pm.response.json().error.code).to.equal('STALE_REVISION'));",
              "pm.test('Message says concurrent edit', () => {",
              "  pm.expect(pm.response.json().error.message).to.include('modified by another user');",
              "});",
              "console.log('Optimistic lock works. Estimator B must reload and re-apply edits.');"
            ]}
          }]
        }
      ]
    }
  ]
}
