{
  "info": {
    "_postman_id": "gfs-proposal-module-v1",
    "name": "GFS — Proposal Module",
    "description": "Complete test collection for the Proposal Generation module.\n\n## Setup\n1. Import this collection into Postman.\n2. Set the collection variables (Variables tab):\n   - `baseUrl`      → http://localhost:3000\n   - `apiVersion`   → v1\n   - `projectId`    → a valid MongoDB ObjectId of a project with an active proposal\n   - `revisionNumber` → 0 (auto-updated by POST BOM tests)\n\n## Run Order\nRun folders top-to-bottom. The POST BOM happy path stores `revisionNumber`\nautomatically so subsequent conflict tests work correctly.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",        "value": "${MONGODB_URI}", "type": "string" },
    { "key": "apiVersion",     "value": "v1",                   "type": "string" },
    { "key": "projectId",      "value": "507f1f77bcf86cd799439011", "type": "string",
      "description": "Replace with a real MongoDB ObjectId of a project that has an active proposal" },
    { "key": "revisionNumber", "value": "0", "type": "string",
      "description": "Auto-populated by POST BOM test scripts. Start at 0 for first save." },
    { "key": "revisionNumberAfterA", "value": "0", "type": "string",
      "description": "Internal — set by Estimator A concurrent test." }
  ],
  "item": [
    {
      "name": "1 — GET BOM",
      "description": "Bill of Materials read endpoint",
      "item": [
        {
          "name": "GET BOM — Happy Path",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/{{projectId}}/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","{{projectId}}","bom"]
            },
            "description": "Returns BOM DTO generated from current ProposalData.\nAll monetary values are in DOLLARS.\nExpected: 200 with bomGroups (array) and bomTotals (object)."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Has bomGroups array', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b).to.have.property('bomGroups');",
              "  pm.expect(b.bomGroups).to.be.an('array');",
              "});",
              "",
              "pm.test('Has bomTotals with dollar fields', () => {",
              "  const { bomTotals } = pm.response.json();",
              "  ['subtotal','shipping','overhead','profit','total'].forEach(k => {",
              "    pm.expect(bomTotals).to.have.property(k);",
              "    pm.expect(typeof bomTotals[k]).to.equal('number');",
              "  });",
              "});",
              "",
              "pm.test('BOM group names are valid', () => {",
              "  const valid = ['Glass System','Framing System','Hardware','Fabrication & Labor'];",
              "  pm.response.json().bomGroups.forEach(g => pm.expect(valid).to.include(g.name));",
              "});",
              "",
              "pm.test('Items use dollar fields NOT cents fields', () => {",
              "  pm.response.json().bomGroups.forEach(g => {",
              "    g.items.forEach(item => {",
              "      pm.expect(item).to.have.property('costPerUnit');",
              "      pm.expect(item).to.have.property('price');",
              "      pm.expect(item).to.not.have.property('costPerUnitInCents');",
              "      pm.expect(item).to.not.have.property('priceInCents');",
              "    });",
              "  });",
              "});"
            ]}
          }]
        },
        {
          "name": "GET BOM — Invalid ObjectId (400)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/not-a-valid-id/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","not-a-valid-id","bom"]
            },
            "description": "Non-ObjectId string as projectId — Zod rejects before controller.\nExpected: 400 Validation Error"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 400', () => pm.response.to.have.status(400));",
              "pm.test('success is false', () => pm.expect(pm.response.json().success).to.equal(false));"
            ]}
          }]
        },
        {
          "name": "GET BOM — No Proposal Exists (404)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/aabbccddeeff001122334455/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","aabbccddeeff001122334455","bom"]
            },
            "description": "Valid ObjectId but no proposal exists for this project.\nExpected: 404 NOT_FOUND"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 404', () => pm.response.to.have.status(404));",
              "pm.test('Error code NOT_FOUND', () => pm.expect(pm.response.json().error.code).to.equal('NOT_FOUND'));"
            ]}
          }]
        }
      ]
    },
    {
      "name": "2 — POST BOM (Save Edits)",
      "description": "Bill of Materials write endpoint",
      "item": [
        {
          "name": "POST BOM — Happy Path (Full Payload)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept",       "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/{{apiVersion}}/proposal/{{projectId}}/bom",
              "host": ["{{baseUrl}}"],
              "path": ["api","{{apiVersion}}","proposal","{{projectId}}","bom"]
            },
            "body": {
              "mode": "raw",
              "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"bomGroups\": [\n    {\n      \"name\": \"Glass System\",\n      \"items\": [\n        { \"id\": \"gs-panel-1\", \"name\": \"Glass Panels\",        \"costPerUnit\": 20.19, \"qty\": 30, \"price\": 605.70 },\n        { \"id\": \"gs-opt-1\",   \"name\": \"IGU / Non-IGU variant\", \"costPerUnit\": 10.00, \"qty\": 10, \"price\": 100.00 }\n      ]\n    },\n    {\n      \"name\": \"Framing System\",\n      \"items\": [\n        { \"id\": \"fr-per-1\",  \"name\": \"Series 1000 - Pedestal\",  \"costPerUnit\": 11.11, \"qty\": 20, \"price\": 222.20 },\n        { \"id\": \"fr-per-2\",  \"name\": \"Series 1000 - Beam\",      \"costPerUnit\": 10.00, \"qty\": 10, \"price\": 100.00 },\n        { \"id\": \"fr-raft-1\", \"name\": \"Series 2000 - Pedestal\",  \"costPerUnit\": 9.00,  \"qty\": 9,  \"price\": 81.00  },\n        { \"id\": \"fr-raft-2\", \"name\": \"Series 2000 - With Plate\",\"costPerUnit\": 10.00, \"qty\": 5,  \"price\": 50.00  }\n      ]\n    },\n    {\n      \"name\": \"Hardware\",\n      \"items\": [\n        { \"id\": \"hw-acc-1\",  \"name\": \"Fasteners\",       \"costPerUnit\": 11.11, \"qty\": 20, \"price\": 222.20 },\n        { \"id\": \"hw-acc-2\",  \"name\": \"Mounting Brackets\",\"costPerUnit\": 10.00, \"qty\": 10, \"price\": 100.00 },\n        { \"id\": \"hw-rail-1\", \"name\": \"Custom Gasket\",    \"costPerUnit\": 9.00,  \"qty\": 9,  \"price\": 81.00  }\n      ]\n    },\n    {\n      \"name\": \"Fabrication & Labor\",\n      \"items\": [\n        { \"id\": \"fab-lab-1\", \"name\": \"Man Hours\",          \"costPerUnit\": 11.11, \"qty\": 20, \"price\": 222.20 },\n        { \"id\": \"fab-lab-2\", \"name\": \"Painting / Finishing\",\"costPerUnit\": 10.00, \"qty\": 10, \"price\": 100.00 },\n        { \"id\": \"fab-eng-1\", \"name\": \"Packaging\",           \"costPerUnit\": 9.00,  \"qty\": 10, \"price\": 90.00  }\n      ]\n    }\n  ],\n  \"bomTotals\": {\n    \"subtotal\": 1974.30,\n    \"shipping\":  58.80,\n    \"overhead\": 197.43,\n    \"profit\":   987.15,\n    \"total\":   3217.68\n  },\n  \"revisionNumber\": {{revisionNumber}}\n}"
            },
            "description": "Saves user BOM edits. All monetary values in DOLLARS.\n`revisionNumber` maps to Mongoose __v — must match the current document version.\nThe test script stores the returned revisionNumber for subsequent requests."
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "",
              "pm.test('Response shape: { success: true, revisionNumber }', () => {",
              "  const b = pm.response.json();",
              "  pm.expect(b.success).to.equal(true);",
              "  pm.expect(b).to.have.property('revisionNumber');",
              "  pm.expect(typeof b.revisionNumber).to.equal('number');",
              "  pm.expect(b.revisionNumber).to.be.greaterThan(0);",
              "});",
              "",
              "const newRev = pm.response.json().revisionNumber;",
              "pm.collectionVariables.set('revisionNumber', String(newRev));",
              "console.log('revisionNumber updated to:', newRev);"
            ]}
          }]
        },
        {
          "name": "POST BOM — Empty Items Arrays (Valid)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
