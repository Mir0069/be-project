    {
      "name": "3 — GET Excel",
      "description": "Excel workbook generation endpoint",
      "item": [
        {
          "name": "GET Excel — 501 While Stub Active",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" }],
            "url": {
