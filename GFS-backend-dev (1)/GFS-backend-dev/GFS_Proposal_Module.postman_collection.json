            },
            "description": "While NotImplementedExcelGenerator is active, returns 501.\nOnce a real IExcelGeneratorService is wired in:\n  - Response is a binary .xlsx buffer\n  - Content-Type: application/vnd.openxmlformats-officedocument.spreadsheetml.sheet\n  - Content-Disposition: attachment; filename=\"proposal-{projectId}.xlsx\"\n\nTo download in Postman: click the arrow next to Send → Send and Download"
          },
          "event": [{
            "listen": "test",
            "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 501) {",
              "  pm.test('501 — stub active (expected)', () => pm.response.to.have.status(501));",
              "  console.log('Wire a real IExcelGeneratorService to enable Excel download.');",
              "} else if (pm.response.code === 200) {",
              "  pm.test('200 — Excel generated', () => pm.response.to.have.status(200));",
              "  pm.test('Content-Type is xlsx MIME', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type'))",
              "      .to.include('application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');",
              "  });",
              "  pm.test('Content-Disposition sets attachment filename', () => {",
              "    const cd = pm.response.headers.get('Content-Disposition');",
              "    pm.expect(cd).to.include('attachment');",
              "    pm.expect(cd).to.include('.xlsx');",
              "  });",
              "}"
            ]}
          }]
        },
